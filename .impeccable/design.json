      "input": "rgba(36, 51, 47, 0.2)",
      "ring": "#28655B",
      "ok": "#28655B",
      "warn": "#94560C",
      "info": "#3F6474"
    },
    "dark": {
      "background": "#151D19",
      "foreground": "#F1EFE8",
      "card": "#1D2722",
      "popover": "#26322C",
      "primary": "#75B5A5",
      "primaryHover": "#8BC6B5",
      "primaryForeground": "#153B33",
      "secondary": "#2A3931",
