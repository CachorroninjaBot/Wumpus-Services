{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "nf3": "0.3.17",
    "vitest": "^4.1.12",
    "brace-expansion@^5.0.0": "^5.0.12",
    "source-map-js": "^1.2.2"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/build-report.mjs && node scripts/sync-public.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/wumpus-typecheck.tsbuildinfo",
    "test": "node --experimental-strip-types --test --test-concurrency=4 src/**/*.test.ts",
    "verify": "npm run typecheck && npm run test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "discord.js": "^14.22.1",
    "jose": "6.2.9",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "zod": "^4.6.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  }
}
