SHARDPAY_API_KEY=
# PostgreSQL compartilhado entre dashboard e bot; configure como segredo no deploy.
DATABASE_URL=

# IDs Discord de compradores Vitalício verificados manualmente na ShardPay
WUMPUS_LIFETIME_DISCORD_IDS=

# Caminho legado de licenças JSON; usado somente para importar dados antigos ou no modo local sem DATABASE_URL.
WUMPUS_LICENSE_PATH=

# ID da sua conta Discord para acesso de dono da plataforma
WUMPUS_OWNER_ID=

# Segredo aleatório independente para assinar sessões HttpOnly (32+ bytes).
# Gere um valor exclusivo por ambiente, por exemplo: openssl rand -base64 48
WUMPUS_SESSION_SECRET=

# Discord — obrigatório para login oficial + bot
DISCORD_CLIENT_ID=1187601667559002225
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://wumpus-dashboard.shardweb.app/auth/discord/callback
DISCORD_TOKEN=

# ID do canal fórum que recebe pedidos de atendimento humano pela dashboard.
# Configure esta variável no painel de ambiente do serviço e reinicie o bot.
WUMPUS_SUPPORT_FORUM_ID=
# Canal de texto no qual o bot publica as avaliações de atendimento humano.
WUMPUS_SUPPORT_RATINGS_CHANNEL_ID=

# OCR.space — chave enviada no header apikey pelo processo do bot
OCR_SPACE_API_KEY=
